flowchart TD
  active(["Borrow record is BORROWED<br/>or displayed as calculated OVERDUE"])
  physical["Borrower brings the physical book<br/>to the library desk"]
  workspace["Librarian or Administrator opens<br/>Loans & Returns"]
  select["Select active loan and choose<br/>Record return"]
  caution["Confirm physical receipt in dialog"]
  api["PUT /api/borrows/admin/:id/approve-return<br/>with Bearer JWT"]
  role{"JWT role is admin<br/>or librarian?"}
  lock["Lock Borrow row;<br/>load and lock Book row"]
  status{"Status is BORROWED, OVERDUE,<br/>or legacy PENDING_RETURN?"}
  update["Set status = RETURNED<br/>set returned_at = current UTC time"]
  book{"Book row exists?"}
  increment["Increment available_copies<br/>without exceeding total_copies"]
  commit["Commit transaction"]
  result(["Return appears in history;<br/>copy is available again when incremented"])

  active --> physical --> workspace --> select --> caution --> api --> role
  role -->|"No"| forbidden["Return 403"]
  role -->|"Yes"| lock --> status
  status -->|"No"| stateError["Return invalid-state error"]
  status -->|"Yes"| update --> book
  book -->|"Yes"| increment --> commit
  book -->|"No"| commit
  commit --> result

  legacy["Legacy path still exists:<br/>PUT /api/borrows/:id/return changes<br/>BORROWED to PENDING_RETURN,<br/>but the current student UI does not call it."]
  legacy -.-> status

  note["The direct workflow records a return only after staff receives the physical book."]
  note -.-> caution
