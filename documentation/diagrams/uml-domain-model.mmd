classDiagram
direction LR

class BaseEntity {
  <<abstract>>
  +UUID id PK
  +to_dict()
}

class User {
  +String username UK
  +String email UK
  +String phone nullable
  +Boolean is_active
  +String role
  +DateTime created_at
  +String google_id UK nullable
  +String avatar_url nullable
  -String password_hash nullable
  +check_password(plain_password) bool
  +is_admin_or_librarian() bool
  +to_dict()
}

class Student {
  +UUID user_id FK UK
  +String student_number UK nullable
  +String course nullable
  +String year_level nullable
  +String enrollment_status
  +to_dict()
}

class Category {
  -String name UK
  +name String
  +to_dict()
}

class Book {
  +String isbn UK nullable
  +String title
  +String author
  +UUID category_id FK nullable
  +String image_url nullable
  +String description nullable
  +Integer pages nullable
  +DateTime created_at
  +Boolean is_deleted
  +DateTime archived_at nullable
  -Integer total_copies
  -Integer available_copies
  +adjust_total_copies(new_total)
  +decrement_available()
  +increment_available()
  +to_dict()
}

class Borrow {
  +UUID user_id FK
  +UUID book_id FK
  +DateTime borrowed_at nullable
  +DateTime due_date nullable
  +DateTime returned_at nullable
  +DateTime approved_at nullable
  +Text rejection_reason nullable
  +String status
  +DateTime created_at
  +is_overdue() bool
  +marked_as_returned()
  +to_dict()
}

class Favorite {
  +UUID user_id FK
  +UUID book_id FK
  +DateTime created_at
  +to_dict()
}

class Review {
  +UUID book_id FK
  +UUID user_id FK
  +Integer rating
  +Text comment nullable
  +DateTime created_at
  +to_dict()
}

class SystemSecurityState {
  +SmallInteger id PK
  +String auth_epoch
  +Boolean maintenance_mode
  +DateTime restore_started_at nullable
  +DateTime updated_at
}

BaseEntity <|-- User
BaseEntity <|-- Student
BaseEntity <|-- Category
BaseEntity <|-- Book
BaseEntity <|-- Borrow
BaseEntity <|-- Favorite
BaseEntity <|-- Review

User "1" *-- "0..1" Student : profile
User "1" -- "0..*" Borrow : borrower
Book "1" -- "0..*" Borrow : borrowed book
User "1" -- "0..*" Favorite : creates
Book "1" -- "0..*" Favorite : identifies
User "1" -- "0..*" Review : writes
Book "1" *-- "0..*" Review : contains
Category "0..1" <-- "0..*" Book : category

note for Favorite "Database unique constraint: user_id + book_id"
note for Review "Rating is service-validated from 1 to 5; no database check or one-review-per-user constraint"
note for Borrow "Status is stored as a string. OVERDUE is normally calculated by to_dict(), not scheduled or persisted."
note for SystemSecurityState "Independent singleton; migration enforces id = 1"
