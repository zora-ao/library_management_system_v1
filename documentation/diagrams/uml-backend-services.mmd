classDiagram
direction LR

class AuthRoutes { <<controller>> }
class BookRoutes { <<controller>> }
class BorrowRoutes { <<controller>> }
class CategoryRoutes { <<controller>> }
class UserRoutes { <<controller>> }
class BackupRoutes { <<controller>> }

class AuthService {
  <<service>>
  +issue_access_token(user)
  +verify_google_credential(token)
  +google_auth(token)
  +login_user(email, password)
  +register_user(username, email, password)
  +get_current_user(user_id)
  +change_password(user_id, current_password, new_password)
}

class BookService {
  <<service>>
  +get_user_favorites(user_id)
  +create_book(form_data, image_file)
  +update_book(book_id, form_data, image_file)
  +archive_book(book_id)
  +restore_book(book_id)
  +add_review(book_id, user_id, rating, comment)
}

class BorrowService {
  <<service>>
  +request_borrow(user_id, book_id)
  +approve_borrow_request(borrow_id)
  +reject_borrow_request(borrow_id, reason)
  +confirm_borrow_pickup(borrow_id)
  +request_return(borrow_id, user_id)
  +approve_return_request(borrow_id)
}

class CategoryService {
  <<service>>
  +get_all_categories()
  +create_category(name)
  +update_category(category_id, new_name)
  +delete_category(category_id)
}

class BackupService {
  <<service>>
  +capabilities()
  +create_backup(passphrase, workspace)
  +inspect_backup(encrypted_path, passphrase, workspace)
  +restore_backup(inspected, expected_digest)
}

class BackupSecurity { <<service module>> }
class BackupEnvelope { <<service module>> }
class PostgresTools { <<adapter module>> }
class SecurityState { <<security module>> }
class CloudinaryAdapter { <<external adapter>> }
class GoogleIdentity { <<external service>> }
class JWTManager { <<framework service>> }

class User { <<entity>> }
class Student { <<entity>> }
class Book { <<entity>> }
class Category { <<entity>> }
class Borrow { <<entity>> }
class Favorite { <<entity>> }
class Review { <<entity>> }

AuthRoutes ..> AuthService
BookRoutes ..> BookService
BorrowRoutes ..> BorrowService
CategoryRoutes ..> CategoryService
UserRoutes ..> AuthService
UserRoutes ..> User : direct ORM access
UserRoutes ..> Student : direct ORM access
UserRoutes ..> CloudinaryAdapter : avatar upload/delete
BackupRoutes ..> BackupService
BackupRoutes ..> BackupSecurity
BackupRoutes ..> BackupEnvelope
BackupRoutes ..> PostgresTools

AuthService ..> User
