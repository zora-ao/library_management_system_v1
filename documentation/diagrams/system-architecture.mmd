flowchart LR
  subgraph actors["Users"]
    student["Student"]
    librarian["Librarian"]
    administrator["Administrator"]
  end

  subgraph browser["Browser client"]
    spa["React + TypeScript SPA<br/>Vite, React Router, Tailwind CSS"]
    query["TanStack React Query<br/>remote-state cache"]
    authstore["AuthContext + localStorage<br/>JWT and serialized user"]
    axios["Axios API client<br/>Bearer-token interceptor"]
  end

  subgraph api["Flask API"]
    blueprints["Blueprint controllers<br/>auth, books, borrows, categories,<br/>users, backups"]
    guards["JWT and role guards<br/>student / librarian / admin"]
    services["Service layer<br/>domain rules and transactions"]
    orm["SQLAlchemy models and ORM"]
    migrations["Flask-Migrate / Alembic"]
  end

  postgres[("PostgreSQL<br/>application data")]
  google["Google Identity Services<br/>ID token + verification keys"]
  cloudinary["Cloudinary<br/>book covers and avatars"]
  pgtools["Native PostgreSQL tools<br/>pg_dump / pg_restore"]
  backupfile["Encrypted backup file<br/>database data only"]

  student --> spa
  librarian --> spa
  administrator --> spa
  spa <--> query
  spa <--> authstore
  query --> axios
  authstore --> axios
  axios -->|"JSON over HTTP(S)"| blueprints
  blueprints -->|"protected endpoints"| guards
  guards -->|"validated request"| services
  blueprints -->|"public endpoints"| services
  services --> orm
  orm <--> postgres
  migrations --> postgres

  spa <--> |"Google sign-in credential"| google
  services -->|"verify Google ID token"| google
  services <--> |"book-cover upload"| cloudinary
  blueprints <--> |"avatar upload/delete"| cloudinary
  services --> pgtools
  pgtools <--> postgres
  pgtools --> backupfile

  note["Logical architecture verified from source.<br/>Hosting beyond the frontend Vercel rewrite is not confirmed."]
