flowchart TD
  start(["Authenticated account selects a book"])
  request["POST /api/borrows<br/>with book_id and Bearer JWT"]
  validate{"JSON body and book_id present?"}
  lockBook["Parse UUID and lock Book row"]
  available{"Book exists and<br/>available_copies > 0?"}
  duplicate{"Same user already has an active<br/>request, reservation, loan, or legacy return?"}
  pending["Create Borrow<br/>status = PENDING_BORROW"]
  staff["Librarian or Administrator<br/>reviews pending request"]
  decision{"Approve or reject?"}

  start --> request --> validate
  validate -->|"No"| requestError["Return 400 error"]
  validate -->|"Yes"| lockBook --> available
  available -->|"No"| unavailableError["Return not found/out-of-stock error"]
  available -->|"Yes"| duplicate
  duplicate -->|"Yes"| duplicateError["Reject duplicate active request"]
  duplicate -->|"No"| pending --> staff --> decision

  decision -->|"Reject"| reason{"Non-empty rejection reason?"}
  reason -->|"No"| reasonError["Return 400 error"]
  reason -->|"Yes"| rejected["Set REJECTED<br/>store trimmed rejection_reason"]
  rejected --> rejectedHistory(["Visible in rejected/history views"])

  decision -->|"Approve"| lockApproval["Lock Borrow and Book rows"]
  lockApproval --> approvable{"Borrow is PENDING_BORROW and<br/>a copy is still available?"}
  approvable -->|"No"| approvalError["Return state/out-of-stock error"]
  approvable -->|"Yes"| reserve["Decrement available_copies<br/>set READY_FOR_PICKUP + approved_at"]
  reserve --> physicalPickup["Student physically receives book"]
  physicalPickup --> confirm["Staff confirms pickup<br/>PUT /admin/:id/confirm-pickup"]
  confirm --> ready{"Borrow is READY_FOR_PICKUP?"}
  ready -->|"No"| pickupError["Return state error"]
  ready -->|"Yes"| active["Set BORROWED + borrowed_at<br/>due_date = pickup time + 14 days"]
  active --> due{"Current time is after due_date<br/>while stored status is BORROWED?"}
  due -->|"No"| borrowedView(["Displayed as active borrowed loan"])
  due -->|"Yes"| overdueView(["Serialized/displayed as OVERDUE<br/>without scheduled persisted transition"])

  note["The API does not enforce a student-only role for creating a borrow request."]
  note -.-> request
