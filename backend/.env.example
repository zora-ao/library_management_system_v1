DATABASE_URL=
PERFORMANCE_DIAGNOSTICS=false
JWT_SECRET_KEY=
BACKUP_TOKEN_SIGNING_KEY=
# Optional directory containing pg_dump and pg_restore. Leave empty when they are on PATH.
BACKUP_PG_BIN_DIR=
# Lower values prepare backups faster but produce larger files. Allowed: 0 through 9.
BACKUP_PG_COMPRESSION_LEVEL=1
# Destructive integration tests only. The database name must contain "test".
TEST_DATABASE_URL=
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use a strong BACKUP_TOKEN_SIGNING_KEY different from JWT_SECRET_KEY.
# Backup restore operation tokens expire after 15 minutes.
